<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@MAGPIE_APP_ID@</id>
  <name>Magpie</name>
  <summary>Scale windows with a choice of scaling algorithms</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <developer id="io.github.magazine0410">
    <name>Magpie contributors</name>
  </developer>
  <description>
    <p>Magpie magnifies a window to the size of the screen or into a larger window, with a choice of scaling algorithms and filters: Lanczos, FSR, Anime4K, CRT shaders and many more, which can be combined into scaling modes. It is made for games and other programs that only run at a low resolution.</p>
    <p>This is the Linux version of the Windows program of the same name. On KDE Plasma and on Sway it scales windows that are open already. On every desktop it can start a program in a session of its own and scale that.</p>
  </description>
  <launchable type="desktop-id">@MAGPIE_APP_ID@.desktop</launchable>
  <url type="homepage">@MAGPIE_REPOSITORY_URL@</url>
  <url type="bugtracker">@MAGPIE_REPOSITORY_URL@/issues</url>
  <provides>
    <binary>magpie</binary>
    <binary>magpie-ctl</binary>
  </provides>
  <categories>
    <category>Utility</category>
  </categories>
  <content_rating type="oars-1.1" />
</component>
